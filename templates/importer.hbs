<div class="importer-body">
  <p class="notice"><strong>Typ partii: {{actorTypeLabel}}</strong>. Zmiana typu wymaga rozpoczęcia nowego importu.</p>
  <fieldset data-json-drop>
    <legend>1. Wczytaj listę aktorów JSON</legend>
    <p>Upuść tutaj plik JSON albo wybierz plik. Możesz też wkleić tablicę eksportów aktorów lub uproszczoną listę opisaną w README.</p>
    <label>Plik JSON <input type="file" name="jsonFile" accept=".json,application/json"></label>
    {{#if fileName}}<p>Wczytano: {{fileName}}</p>{{/if}}
    <label>Lista aktorów <textarea name="jsonText" rows="10" spellcheck="false" placeholder='[{"name":"Jan","skills":[{"name":"Nasłuchiwanie","value":60}]}]'>{{text}}</textarea></label>
    <label>Folder aktorów <select name="folder"><option value="">Bez folderu</option>{{#each folders}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <button type="button" data-command="preview">Przygotuj podgląd listy</button>
  </fieldset>
  <label class="remember-option"><input type="checkbox" name="rememberMatches" {{#if remember}}checked{{/if}}> Zapamiętuj dopasowania nazw po przeciągnięciu przedmiotu</label>
  <section data-preview aria-live="polite">
    {{#if hasEntries}}
    <h3>2. Przypisz przedmioty z katalogu Items</h3>
    <p class="hint">Dostępne wzorce: {{catalogCount}}. Otwórz zakładkę Items w Foundry i przeciągnij przedmiot na odpowiedni wiersz poniżej albo użyj wyszukiwarki. Wartości procentowe są osobne dla każdego aktora.</p>
    <table><thead><tr><th>Import</th><th>Aktor i przypisania</th></tr></thead><tbody>
      {{#each entries}}<tr>
        <td><input type="checkbox" data-entry="{{index}}" aria-label="Importuj {{name}}" {{#if selected}}checked{{/if}} {{#if disabled}}disabled{{/if}}></td>
        <td><strong>{{name}}</strong> <span>{{status}}</span><p>{{summary}}</p>
          {{#unless createdId}}<div class="actor-item-drop" data-actor-item-drop data-actor="{{index}}">Dodaj lub przypisz Item temu aktorowi — przeciągnij z zakładki Items</div>{{/unless}}
          {{#if pending}}<p class="entry-error">Wskaż brakujące przedmioty i wartości procentowe.</p>{{/if}}
          {{#each errors}}<p class="entry-error">{{this}}</p>{{/each}}
          {{#each warnings}}<p class="hint">{{this}}</p>{{/each}}
          {{#each requests}}
          <div class="item-match" data-item-drop data-actor="{{entryIndex}}" data-request="{{key}}">
            <p><strong>{{typeLabel}}: {{name}}</strong>{{#if requiredBy}} <span class="hint">(wymagana przez broń)</span>{{/if}}</p>
            <p>→ {{matchedName}}</p><p class="hint">{{reason}}</p>
            {{#if isSkill}}<label>Wartość dla tego aktora (%) <input type="number" min="0" step="any" value="{{value}}" data-percent-request="{{key}}" data-actor="{{entryIndex}}" placeholder="Podaj procent" {{#if locked}}disabled{{/if}}></label>
            {{else}}{{#if hasValue}}<p>Wartość ataku z JSON: {{value}}%</p>{{/if}}{{/if}}
            <button type="button" data-command="match" data-actor="{{entryIndex}}" data-request="{{key}}" {{#if locked}}disabled{{/if}}>Wyszukaj w Items / zmień / pomiń</button>
          </div>
          {{/each}}
        </td>
      </tr>{{/each}}
    </tbody></table>
    {{/if}}
  </section>
  <button type="button" data-command="import" {{#unless canImport}}disabled{{/unless}}>Importuj zaznaczonych aktorów</button>
  <p class="hint">Powstaną nowi aktorzy i kopie wskazanych Items. Wzorce pozostają bez zmian. Udane wiersze są pomijane przy ponowieniu w tym samym podglądzie.</p>
</div>
